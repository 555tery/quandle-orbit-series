import QuandleResearch.Proofs.Q57.Principal
import QuandleResearch.Checks.Q57StatementAudit

/-! Orbit tools for the positive answer. Use Mathlib's permutation
groups, closure induction, adjoint identity and orbit API, reusing the
finite-walk results already verified in the statement audit. -/
namespace QuandleResearch.Q57
open BCNW Issue013
variable {X Y : Type*} [_root_.Quandle X] [_root_.Quandle Y]

/-- The ambient action of the translation subgroup preserves a subrack. -/
theorem translation_preserves {s : Set X} (hs : IsSubrack s)
    {g : Equiv.Perm X} (hg : g ∈ translationGroup s) :
    ∀ z : X, z ∈ s ↔ g z ∈ s := by
  change g ∈ Subgroup.closure ((_root_.Rack.act' : X → Equiv.Perm X) '' s) at hg
  induction hg using Subgroup.closure_induction with
  | mem g hg =>
    obtain ⟨y, hy, rfl⟩ := hg
    intro z
    constructor
    · intro hz
      exact (hs y hy z hz).1
    · intro hz
      have h := (hs y hy (_root_.Rack.act' y z) hz).2
      simpa only [Equiv.symm_apply_apply] using h
  | one => intro z; rfl
  | mul g h hg hh ig ih =>
    intro z
    exact (ih z).trans (ig (h z))
  | inv g hg ih =>
    intro z
    change z ∈ s ↔ g.symm z ∈ s
    simpa only [Equiv.apply_symm_apply] using (ih (g.symm z)).symm

/-- Surjectivity onto the image orbit requires no injectivity of the
quandle homomorphism. The backward walk stays in the subrack. -/
theorem image_orbit (f : ShelfHom X Y) {s : Set X}
    (hs : IsSubrack s) {x : X} (hx : x ∈ s) :
    f '' orbitIn s x = orbitIn (f '' s) (f x) := by
  ext z
  constructor
  · rintro ⟨w, hw, rfl⟩
    exact ⟨⟨w, hw.1, rfl⟩,
      (StatementAudit.walk_iff_orbit _ _ _).mp
        (StatementAudit.walk_map f s x w ((StatementAudit.walk_iff_orbit _ _ _).mpr hw.2))⟩
  · intro hz
    obtain ⟨w, hw, hwalk⟩ := StatementAudit.walk_lift f s x z ((StatementAudit.walk_iff_orbit _ _ _).mpr hz.2)
    have ho := (StatementAudit.walk_iff_orbit _ _ _).mp hwalk
    obtain ⟨g, hg⟩ := MulAction.mem_orbit_iff.mp ho
    change g.val x = w at hg
    have hm : w ∈ s := hg ▸ (translation_preserves hs g.property x).mp hx
    exact ⟨w, ⟨hm, ho⟩, hw⟩

theorem image_principal (f : ShelfHom X Y) {s : Set X}
    (hs : IsSubrack s) {x : X} (hx : x ∈ s) (n : Nat) :
    f '' principalSeries s x n = principalSeries (f '' s) (f x) n := by
  induction n with
  | zero => rfl
  | succ n ih =>
    change f '' orbitIn (principalSeries s x n) x =
      orbitIn (principalSeries (f '' s) (f x) n) (f x)
    rw [image_orbit f (principal_mem_and_subrack hs hx n).2
      (principal_mem_and_subrack hs hx n).1, ih]

/-- Equivariance of translations under generated permutations is
Mathlib's Rack.ad_conj extended by native subgroup closure induction. -/
theorem translation_conj {s : Set X} {g : Equiv.Perm X}
    (hg : g ∈ translationGroup s) :
    ∀ y : X, _root_.Rack.act' (g y) = g * _root_.Rack.act' y * g⁻¹ := by
  change g ∈ Subgroup.closure ((_root_.Rack.act' : X → Equiv.Perm X) '' s) at hg
  induction hg using Subgroup.closure_induction with
  | mem g hg =>
    obtain ⟨x, hx, rfl⟩ := hg
    exact _root_.Rack.ad_conj x
  | one =>
    intro y
    change _root_.Rack.act' y = 1 * _root_.Rack.act' y * (1 : Equiv.Perm X)⁻¹
    simp
  | mul g h hg hh ig ih =>
    intro y
    change _root_.Rack.act' (g (h y)) = (g*h) * _root_.Rack.act' y * (g*h)⁻¹
    rw [ig, ih]
    group
  | inv g hg ih =>
    intro y
    change _root_.Rack.act' (g.symm y) = g⁻¹ * _root_.Rack.act' y * (g⁻¹)⁻¹
    have he := ih (g.symm y)
    rw [Equiv.apply_symm_apply] at he
    rw [he]
    group

/-- A generated permutation preserving a set normalizes the subgroup
generated by its translations. Use the native normalizer API. -/
theorem normalizer_of_preserves {s t : Set X} {G : Subgroup (Equiv.Perm X)}
    (hG : G ≤ translationGroup t)
    (h : ∀ g ∈ G, ∀ y ∈ s, g y ∈ s) :
    G ≤ Subgroup.normalizer (translationGroup s) := by
  apply Subgroup.le_normalizer_closure_iff.mpr
  intro g hg p hp
  obtain ⟨y, hy, rfl⟩ := hp
  rw [← translation_conj (hG hg) y]
  exact translation_mem (h g hg y hy)

/-- Successive translation subgroups of a principal series are
relatively normal, using Mathlib's normalizer rather than a custom
normal-subgroup structure. -/
theorem orbit_step_normalizer {s : Set X} (hs : IsSubrack s) (x : X) :
    translationGroup s ≤ Subgroup.normalizer (translationGroup (orbitIn s x)) := by
  apply normalizer_of_preserves le_rfl
  intro g hg y hy
  let g' : translationGroup s := ⟨g, hg⟩
  exact ⟨(translation_preserves hs hg y).mp hy.1,
    MulAction.mem_orbit_of_mem_orbit g' hy.2⟩

end QuandleResearch.Q57
