import QuandleResearch.Proofs.Q525.MatrixAlgebra
import QuandleResearch.Proofs.Q525.Coefficients
import QuandleResearch.Proofs.Q525.ConjugacyClass
import QuandleResearch.Proofs.Q525.AffineInvolutions

/-! Minimal proof of Q525(a). The only depth estimate is a ternary
product induction. No exact Pell bounds, group order, or cardinalities
of orbit layers are needed. -/
namespace QuandleResearch.Q525.MatrixModel
open QuandleResearch.Q525
open BCNW
variable {R : Type*} [CommRing R]

/-- The two-element subgroup generated by the marked transvection
over the residue field. -/
def residue : Subgroup ((Mat (ZMod 2))ˣ) where
  carrier := {g | g=1 ∨ g=T12 1}
  one_mem' := Or.inl rfl
  mul_mem' := by
    intro a b ha hb
    change a=1 ∨ a=T12 1 at ha
    change b=1 ∨ b=T12 1 at hb
    rcases ha with rfl|rfl <;> rcases hb with rfl|rfl
    · exact Or.inl (one_mul 1)
    · exact Or.inr (one_mul _)
    · exact Or.inr (mul_one _)
    · exact Or.inl (T12_square (by intro x; fin_cases x <;> decide))
  inv_mem' := by
    intro a ha
    change a=1 ∨ a=T12 1 at ha
    rcases ha with rfl|rfl
    · exact Or.inl inv_one
    · exact Or.inr (T_inv_self (by intro x; fin_cases x <;> decide) 0 1 (by decide) 1)

abbrev reduce (aug : R →+* ZMod 2) :
    (Mat R)ˣ →* (Mat (ZMod 2))ˣ :=
  Units.map aug.mapMatrix.toMonoidHom

def ambient (aug : R →+* ZMod 2) : Subgroup (Mat R)ˣ :=
  residue.comap (reduce aug)

theorem reduce_T (aug : R →+* ZMod 2) (i j : Fin 3) (h : i≠j) (x : R) :
    reduce aug (T i j h x) = T i j h (aug x) := by
  apply Units.ext
  change (Matrix.transvection i j x).map aug = Matrix.transvection i j (aug x)
  simp [Matrix.transvection, Matrix.map_single]

def mark (aug : R →+* ZMod 2) : ambient aug :=
  ⟨T12 1, by
    change reduce aug (T12 1) ∈ residue
    rw [reduce_T, map_one]
    exact Or.inr rfl⟩

def liftT (aug : R →+* ZMod 2) (i j : Fin 3) (h : i≠j)
    (x : R) (hx : aug x=0) : ambient aug :=
  ⟨T i j h x, by
    change reduce aug (T i j h x) ∈ residue
    rw [reduce_T,hx,T_zero]
    exact Or.inl rfl⟩

abbrev U13 (aug : R →+* ZMod 2) (x : R) (hx : aug x=0) := liftT aug 0 2 (by decide) x hx
abbrev U21 (aug : R →+* ZMod 2) (x : R) (hx : aug x=0) := liftT aug 1 0 (by decide) x hx
abbrev U23 (aug : R →+* ZMod 2) (x : R) (hx : aug x=0) := liftT aug 1 2 (by decide) x hx
abbrev U31 (aug : R →+* ZMod 2) (x : R) (hx : aug x=0) := liftT aug 2 0 (by decide) x hx
abbrev U32 (aug : R →+* ZMod 2) (x : R) (hx : aug x=0) := liftT aug 2 1 (by decide) x hx

theorem entry21_zero (aug : R →+* ZMod 2) (g : ambient aug) :
    aug (g.val.val 1 0)=0 := by
  have hg : reduce aug g.val = 1 ∨ reduce aug g.val = T12 1 := g.property
  rcases hg with hg|hg
  · have h := congrArg (fun u : (Mat (ZMod 2))ˣ => u.val 1 0) hg
    change aug (g.val.val 1 0) = (1 : Mat (ZMod 2)) 1 0 at h
    simpa [Matrix.one_apply] using h
  · have h := congrArg (fun u : (Mat (ZMod 2))ˣ => u.val 1 0) hg
    change aug (g.val.val 1 0) = Matrix.transvection 0 1 (1 : ZMod 2) 1 0 at h
    simpa [Matrix.transvection,Matrix.one_apply,Matrix.single_apply] using h

theorem mark_square (aug : R →+* ZMod 2) (hc : ∀ x : R, x+x=0) :
    mark aug * mark aug = 1 := by
  apply Subtype.ext
  exact T12_square hc

/-- A marked transvection and any of its conjugates have product of
order dividing four. This is all the LR₂ proof needs. -/
theorem fourth_mark (aug : R →+* ZMod 2) (hc : ∀ x : R, x+x=0)
    (hk : ∀ x, aug x=0 → x*x=0) (g : ambient aug) :
    (mark aug*(g*mark aug*g⁻¹))^4=1 := by
  apply Subtype.ext
  apply Units.ext
  let H : Mat R := g.val.val
  let K : Mat R := (g⁻¹).val.val
  let N : Mat R := Matrix.single 0 1 1
  let M : Mat R := H*N*K
  have hHK : H*K=1 := congrArg (fun x : ambient aug => x.val.val) (mul_inv_cancel g)
  have hKH : K*H=1 := congrArg (fun x : ambient aug => x.val.val) (inv_mul_cancel g)
  have hN : N*N=0 := by
    dsimp [N]
    exact Matrix.single_mul_single_of_ne 0 1 0 (by decide) 1
  have hM : M*M=0 := by
    calc
      M*M = H*N*(K*H)*N*K := by dsimp [M]; noncomm_ring
      _ = 0 := by rw [hKH,mul_one,mul_assoc H N N,hN]; simp
  have hcross := cross_sq_zero H K
    (hk _ (entry21_zero aug g)) (hk _ (entry21_zero aug g⁻¹))
  have hc' : ∀ A : Mat R, A+A=0 := by
    intro A
    ext i j
    exact hc (A i j)
  have he : H*(1+N)*K=1+M := by
    rw [mul_add,add_mul,mul_one,hHK]
  change ((1+N)*(H*(1+N)*K))^4=1
  rw [he]
  exact fourth_of_cross_sq_zero hc' N M hN hM hcross.1 hcross.2

theorem localTwo (aug : R →+* ZMod 2) (hc : ∀ x : R, x+x=0)
    (hk : ∀ x, aug x=0 → x*x=0) :
    LocallyReductive (X := Class (mark aug)) 2 := by
  apply Class.locallyReductiveTwo (mark_square aug hc)
  intro x y
  obtain ⟨g,hg⟩ := MulAction.mem_orbit_iff.mp x.property
  obtain ⟨h,hh⟩ := MulAction.mem_orbit_iff.mp y.property
  let b := ConjAct.ofConjAct g
  let c := ConjAct.ofConjAct h
  let d := b⁻¹*c
  let a := mark aug
  change b*a*b⁻¹=x.val at hg
  change c*a*c⁻¹=y.val at hh
  have he : x.val*y.val=MulAut.conj b (a*(d*a*d⁻¹)) := by
    rw [← hg,← hh]
    change (b*a*b⁻¹)*(c*a*c⁻¹)=b*(a*(d*a*d⁻¹))*b⁻¹
    dsimp [d]
    group
  rw [he,← map_pow,fourth_mark aug hc hk d,map_one]

/-- Products with ternary depth. The base consists of augmentation
kernel elements. This replaces all Pell-number and exact-size machinery. -/
def Good (aug : R →+* ZMod 2) : Nat → R → Prop
  | 0,x => aug x=0
  | n+1,x => ∃ a b c : R, Good aug n a ∧ Good aug n b ∧ Good aug n c ∧ x=a*b*c

theorem good_zero (aug : R →+* ZMod 2) (n : Nat) {x : R}
    (hx : Good aug n x) : aug x=0 := by
  induction n generalizing x with
  | zero => exact hx
  | succ n ih =>
    obtain ⟨a,b,c,ha,hb,hc,rfl⟩ := hx
    simp [map_mul,ih ha]

theorem good_mul (aug : R →+* ZMod 2) (n : Nat) {x : R}
    (hx : Good aug n x) (y : R) : Good aug n (x*y) := by
  induction n generalizing x with
  | zero => change aug x=0 at hx; change aug (x*y)=0; simp [hx]
  | succ n ih =>
    obtain ⟨a,b,c,ha,hb,hc,rfl⟩ := hx
    exact ⟨a*y,b,c,ih ha,hb,hc,by ring⟩

theorem good_prod (aug : R →+* ZMod 2) (n : Nat) (ts : List R)
    (hl : ts.length=3^n) (hz : ∀ t∈ts, aug t=0) :
    Good aug n ts.prod := by
  induction n generalizing ts with
  | zero =>
    cases ts with
    | nil => simp at hl
    | cons t rest =>
      have hr : rest=[] := by
        apply List.length_eq_zero_iff.mp
        simp at hl
        omega
      subst rest
      change aug ([t].prod)=0
      simpa using hz t (by simp)
  | succ n ih =>
    let d := 3^n
    let a := ts.take d
    let b := (ts.drop d).take d
    let c := (ts.drop d).drop d
    have hlen : ts.length=d*3 := by simpa [d,pow_succ] using hl
    have ha : a.length=d := by simp [a,List.length_take]; omega
    have hb : b.length=d := by simp [b,List.length_take,List.length_drop]; omega
    have hc : c.length=d := by simp [c,List.length_drop]; omega
    have habc : a++b++c=ts := by
      dsimp [a,b,c]
      rw [List.append_assoc,List.take_append_drop,List.take_append_drop]
    have hza : ∀ t∈a, aug t=0 := by
      intro t ht
      apply hz t
      rw [← habc]
      simp [ht]
    have hzb : ∀ t∈b, aug t=0 := by
      intro t ht
      apply hz t
      rw [← habc]
      simp [ht]
    have hzc : ∀ t∈c, aug t=0 := by
      intro t ht
      apply hz t
      rw [← habc]
      simp [ht]
    refine ⟨a.prod,b.prod,c.prod,ih a ha hza,ih b hb hzb,ih c hc hzc,?_⟩
    rw [← habc,List.prod_append,List.prod_append]

/-- Transfer an explicitly computed commutator from the matrix group
to the subgroup used in the model. -/
theorem lift_comm {aug : R →+* ZMod 2} {H : Subgroup (ambient aug)}
    {g z w : ambient aug} (hg : g∈H) (hz : z∈next (mark aug) H)
    (he : g.val*z.val*g.val⁻¹*z.val⁻¹=w.val) : w∈next (mark aug) H := by
  have h : g*z*g⁻¹*z⁻¹=w := Subtype.ext he
  rw [← h]
  exact comm_mem_next hg hz

/-- The required lower bound: every ternary product of depth n
occurs in all three indicated transvection subgroups at tower stage n. -/
theorem tower_products (aug : R →+* ZMod 2) (hc : ∀ x : R, x+x=0)
    (n : Nat) (x : R) (hx : Good aug n x) :
    U21 aug x (good_zero aug n hx) ∈ tower (mark aug) n ∧
    U23 aug x (good_zero aug n hx) ∈ tower (mark aug) n ∧
    U31 aug x (good_zero aug n hx) ∈ tower (mark aug) n := by
  induction n generalizing x with
  | zero => exact ⟨Subgroup.mem_top _,Subgroup.mem_top _,Subgroup.mem_top _⟩
  | succ n ih =>
    obtain ⟨a,b,c,ha,hb,hc',rfl⟩ := hx
    let H := tower (mark aug) n
    have hmark : mark aug ∈ next (mark aug) H := self_mem_next _ _
    have two (u v : R) (hu : Good aug n u) (hv : Good aug n v) :
        U23 aug (u*v) (by simp [good_zero aug n hu]) ∈ next (mark aug) H ∧
        U31 aug (u*v) (by simp [good_zero aug n hu]) ∈ next (mark aug) H := by
      have h13 : U13 aug v (good_zero aug n hv) ∈ next (mark aug) H :=
        lift_comm (ih v hv).2.1 hmark (comm_23_12 hc v)
      have h32 : U32 aug v (good_zero aug n hv) ∈ next (mark aug) H :=
        lift_comm (ih v hv).2.2 hmark (comm_31_12 hc v)
      exact ⟨lift_comm (ih u hu).1 h13 (comm_21_13 hc u v),
        lift_comm (ih u hu).1 h32 (comm_21_32 hc u v)⟩
    have h23 := (two b c hb hc').1
    have h21 : U21 aug (a*(b*c)) (by simp [good_zero aug n ha]) ∈ next (mark aug) H :=
      lift_comm (ih a ha).2.2 h23 (comm_31_23 hc a (b*c))
    have hp := two (a*b) c (good_mul aug n ha b) hc'
    refine ⟨?_,hp.1,hp.2⟩
    simpa only [mul_assoc] using h21

theorem finite_witness (n : Nat) :
    ∃ (X : Type) (q : _root_.Quandle X),
      letI := q
      Finite X ∧ LocallyReductive (X := X) 2 ∧
      ∃ x y : X, y≠x ∧ y∈principalSeries Set.univ x n := by
  obtain ⟨R,r,h⟩ := augmented_coefficient_exists (3^n)
  letI := r
  obtain ⟨hf,hc,aug,hk,ts,hlen,hzero,hprod⟩ := h
  letI : Finite R := hf
  letI : Finite (Mat R) := Finite.of_injective
    (fun A : Mat R => fun i j => A i j) (by
      intro A B he
      ext i j
      exact congrFun (congrFun he i) j)
  letI : Finite (Mat R)ˣ := Finite.of_injective
    (fun u : (Mat R)ˣ => u.val) (fun _ _ h => Units.ext h)
  have hg := good_prod aug n ts hlen hzero
  have ht := (tower_products aug hc n ts.prod hg).2.1
  refine ⟨Class (mark aug),inferInstance,inferInstance,localTwo aug hc hk,?_⟩
  apply principal_witness_of_tower ht
  intro he
  exact noncentral_23 hc hprod (congrArg Subtype.val he)

/-- Both original boundedness questions, without further hypotheses. -/
theorem partA : Issue014.negativeA.{0} := by
  apply Issue014.negativeA_of_unboundedJAt 2 (by decide)
  apply Issue014.unboundedJAt_two_of_principal_witnesses
  intro n _
  exact finite_witness n

theorem solution : Issue014.bothNegative.{0} :=
  ⟨partA,QuandleResearch.Q525.partB⟩

#print axioms partA
#print axioms solution
end QuandleResearch.Q525.MatrixModel
