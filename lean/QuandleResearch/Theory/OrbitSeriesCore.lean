import Mathlib.Algebra.Quandle
import Mathlib.GroupTheory.GroupAction.Basic
import Mathlib.GroupTheory.Perm.Basic

/-! Source: Bonatto–Crans–Nasybullov–Whitney, Quandles with orbit
series conditions, arXiv:2004.10227v3, §§2.1, 3.1–3.2, 4.1.
Use Mathlib's native left quandle convention, not a second axiom system.
The orbit-series definitions also make sense for racks. -/
namespace QuandleResearch.BCNW

variable {X : Type*} [_root_.Rack X]

/-- Closure under the operation and inverse operation of the rack. -/
def IsSubrack (s : Set X) : Prop :=
  ∀ y ∈ s, ∀ x ∈ s, Shelf.act y x ∈ s ∧ (_root_.Rack.act' y).symm x ∈ s

/-- Ambient permutations generated by translations indexed by s.
When s is a subrack, restriction of this action to s gives its inner
action: each generator and its inverse preserves s. -/
def translationGroup (s : Set X) : Subgroup (Equiv.Perm X) :=
  Subgroup.closure ((_root_.Rack.act' : X → Equiv.Perm X) '' s)

def orbitRel (s : Set X) (x z : X) : Prop :=
  (MulAction.orbitRel (translationGroup s) X).r x z

/-- For x in the subrack s, this is Orb(x,s) of §2.1.
The intersection explicitly restricts the ambient orbit to s. -/
def orbitIn (s : Set X) (x : X) : Set X :=
  s ∩ MulAction.orbit (translationGroup s) x

/-- Equation (7) of §4.1, with all choices of orbit at every step. -/
def IsOrbitSeries (s : Set X) (a : Nat → Set X) : Prop :=
  a 0 = s ∧ (∀ n, IsSubrack (a n)) ∧
    ∀ n, ∃ x ∈ a n, a (n+1) = orbitIn (a n) x

def OS (s : Set X) : Prop :=
  ∀ a, IsOrbitSeries s a → ∃ n, a n = a (n+1)

def OSBound (s : Set X) (k : Nat) : Prop :=
  ∀ a, IsOrbitSeries s a → ∃ n ≤ k, a n = a (n+1)

def principalSeries (s : Set X) (x : X) : Nat → Set X
  | 0 => s
  | n+1 => orbitIn (principalSeries s x n) x

/-- tOS_n: every orbit series reaches a singleton by stage n.
A trivial subquandle of more than one element does not suffice. -/
def Trivializing (n : Nat) : Prop :=
  ∀ (a : Nat → Set X), IsOrbitSeries Set.univ a →
    ∃ r ≤ n, ∃ x : X, a r = {x}

def TrivializingEventually : Prop :=
  ∀ (a : Nat → Set X), IsOrbitSeries Set.univ a →
    ∃ r, ∃ x : X, a r = {x}

/-- Left-associated expression from (3), evaluated by Mathlib List.foldl. -/
abbrev leftFold (x : X) (ys : List X) : X := ys.foldl Shelf.act x

/-- R_n, §3.1 equation (3). -/
def Reductive (n : Nat) : Prop :=
  ∀ (a b : X) (cs : List X), cs.length = n →
    leftFold a cs = leftFold b cs

/-- LR_n, §3.2 equation (5). The repeated second operand is fixed. -/
def LocallyReductive (n : Nat) : Prop :=
  ∀ a b : X, leftFold a (List.replicate n b) = b

/-- Optional minimal positive index, using Mathlib's order-theoretic
least-element predicate. The original question only needs membership. -/
def ExactPositiveIndex (P : Nat → Prop) (n : Nat) : Prop :=
  IsLeast {m : Nat | 0 < m ∧ P m} n

end QuandleResearch.BCNW
