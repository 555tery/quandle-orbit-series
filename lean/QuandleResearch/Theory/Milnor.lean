import QuandleResearch.Theory.LinkPresentations

/-! Algebraic Magnus coefficients and Milnor's indeterminacy.
Reference: J.-B. Meilhan, Linking number and Milnor invariants,
§3, https://www-fourier.univ-grenoble-alpes.fr/~meilhan/lkmilnor.pdf .
Coefficients are evaluated on finite signed words representing elements
of Mathlib FreeGroup. No invariance under choice of peripheral data is
asserted in this module. -/
namespace QuandleResearch.Milnor
noncomputable section
open Classical
open scoped BigOperators

abbrev Word (n : Nat) := List (Fin n × Bool)

/-- Coefficient of a monomial in 1+X_i or its geometric-series inverse. -/
def letterCoeff {n : Nat} (a : Fin n × Bool) (w : List (Fin n)) : Int :=
  if w = [] then 1
  else if a.2 then (if w = [a.1] then 1 else 0)
  else if ∀ i ∈ w, i = a.1 then (-1 : Int)^w.length else 0

/-- Noncommutative coefficient convolution over all cuts of a word.
There is no commutative polynomial substitution here. -/
def magnusCoeff {n : Nat} : Word n → List (Fin n) → Int
  | [], w => if w = [] then 1 else 0
  | a :: rest, w =>
      ∑ k ∈ Finset.range (w.length+1),
        letterCoeff a (w.take k) * magnusCoeff rest (w.drop k)

/-- The integer coefficient of the preferred longitude word indexed by
the last entry of I. Length-zero and length-one indices contribute 0. -/
def mu {n : Nat} (longitudes : Fin n → Word n) (I : List (Fin n)) : Int :=
  if I.length < 2 then 0 else
    match I.getLast? with
    | none => 0
    | some j => magnusCoeff (longitudes j) I.dropLast

/-- Delete at least one entry and cyclically permute what remains. -/
def ProperCyclicSubsequence {n : Nat} (J I : List (Fin n)) : Prop :=
  ∃ K : List (Fin n), K.Sublist I ∧ K.length < I.length ∧
    ∃ u v : List (Fin n), K = u ++ v ∧ J = v ++ u

/-- The ideal generated by the lower coefficients is (Delta(I)).
Using the ideal instead of a chosen gcd automatically handles Delta=0. -/
def indeterminacy {n : Nat} (longitudes : Fin n → Word n)
    (I : List (Fin n)) : Ideal Int :=
  Ideal.span {z | ∃ J, ProperCyclicSubsequence J I ∧ z = mu longitudes J}

def muBar {n : Nat} (longitudes : Fin n → Word n) (I : List (Fin n)) :
    Int ⧸ indeterminacy longitudes I :=
  Ideal.Quotient.mk _ (mu longitudes I)

/-- Compare residues in the same ideal quotient, without choosing a
noncanonical isomorphism between two independently chosen moduli. -/
def SameResidue {n : Nat} (a b : Fin n → Word n) (I : List (Fin n)) : Prop :=
  indeterminacy a I = indeterminacy b I ∧
    mu a I - mu b I ∈ indeterminacy a I

/-- Peripheral data in a specified group: the chosen longitude words
represent the given longitudes modulo the d-th Mathlib central term.
The group and the preferred meridians/longitudes are inputs; identifying
them with the geometric link complement remains a separate obligation.
The source's Gamma_1=G corresponds to lowerCentralSeries G 0. -/
structure PeripheralApproximation (n : Nat) (G : Type) [Group G] (d : Nat) where
  meridian : Fin n → G
  longitude : Fin n → G
  words : Fin n → Word n
  represents : ∀ j,
    (FreeGroup.lift meridian (FreeGroup.mk (words j)))⁻¹ * longitude j ∈
      lowerCentralSeries G d

end
end QuandleResearch.Milnor
